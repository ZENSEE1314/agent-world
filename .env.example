# Brain selection: mock | anthropic | openai | ollama
BRAIN=mock

# API keys (only needed for non-mock brains)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama (for local or Railway-hosted Ollama instance)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Simulation speed (multiplies all decay / tick rates; 1.0 = spec default)
SIM_SPEED=60

# Tick interval in real seconds
TICK_SECONDS=3

# Port
PORT=8000
